# Copy this file to .env and fill in your own values.
# Never commit .env — it is listed in .gitignore.

# JWT signing secrets (use long random strings, e.g. `openssl rand -hex 64`)
ACCESS_TOKEN_PRIVATE_KEY=
REFRESH_TOKEN_PRIVATE_KEY=
FORGET_PASSWORD_TOKEN_PRIVATE_KEY=

# MongoDB Atlas connection (mongodb+srv://USERNAME:PASSWORD@HOST)
MONGO_HOST=
MONGO_USERNAME=
MONGO_PASSWORD=

# HTTP / Socket.IO server port
PORT=5000
SERVER_PORT=5000

# Allowed CORS origin (UniBot frontend)
FRONTEND_URL=http://localhost:3000

# Google Gemini API key (https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# SMTP settings for verification and password-reset emails
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=

# Logger level: fatal | error | warn | info | debug | trace
LOG_LEVEL=info
